<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Weverse DM 实时翻译"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="使用 ChatGPT Plus / Pro 套餐在线翻译，无需填写 API Key。"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Continue with ChatGPT" />

        <Button
            android:id="@+id/buttonTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="测试套餐翻译" />

        <Button
            android:id="@+id/buttonToggleTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="实时翻译：已开启" />

        <Button
            android:id="@+id/buttonToggleOcr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OCR 兜底：已开启" />

        <Button
            android:id="@+id/buttonAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开无障碍设置" />

        <Button
            android:id="@+id/buttonOpenWeverse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="打开 Weverse" />

        <Button
            android:id="@+id/buttonDisconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清除本机 ChatGPT 登录" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="12dp"
            android:text="ChatGPT：○ 待登录"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="使用提示：进入 Weverse 后，右上方会出现一个小型「译 / 原」快捷按钮；点任意翻译气泡也可以单独在原文和译文之间切换。"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="隐私说明：无障碍服务仅监听 Weverse 包名。翻译时，当前可见韩文和最近上下文会发送到 OpenAI。OCR 仅在无障碍节点几乎读取不到韩文时触发，并在本机使用 ML Kit 识别。ChatGPT OAuth 凭据保存在本应用私有存储中。"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
